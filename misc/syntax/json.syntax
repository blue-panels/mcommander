#
# JSON syntax highlighting
# for MC Editor/CoolEdit
#
# Author: Sergii Pylypenko <x.pelya.x@gmail.com>
#
# Keys, string values, numbers and constants each have a color of their own.
# A key is a string followed by a colon, and the colon takes its color: the
# rules cannot look ahead of what they color.  A key that holds an escaped
# quote is colored as a value.

context default

    #=========================
    # Keys
    keyword "*"\[\s\t\]: yellow

    #=========================
    # Constants
    keyword whole true brightred
    keyword whole false brightred
    keyword whole null brightred

    #=========================
    # Numbers, the longest form first: the first that fits is taken
    keyword whole \[-\]\{0123456789\}\[0123456789\]\.\{0123456789\}\[0123456789\]\{eE\}\{\-\+\}\{0123456789\}\[0123456789\] brightmagenta
    keyword whole \[-\]\{0123456789\}\[0123456789\]\.\{0123456789\}\[0123456789\]\{eE\}\{0123456789\}\[0123456789\] brightmagenta
    keyword whole \[-\]\{0123456789\}\[0123456789\]\{eE\}\{\-\+\}\{0123456789\}\[0123456789\] brightmagenta
    keyword whole \[-\]\{0123456789\}\[0123456789\]\{eE\}\{0123456789\}\[0123456789\] brightmagenta
    keyword whole \[-\]\{0123456789\}\[0123456789\]\.\{0123456789\}\[0123456789\] brightmagenta
    keyword whole \[-\]\{0123456789\}\[0123456789\] brightmagenta

    #=========================
    # Separators
    keyword { brightcyan
    keyword } brightcyan
    keyword [ brightcyan
    keyword ] brightcyan
    keyword , brightcyan
    keyword : brightcyan

#=============================
# Comments.  JSON has none, but many files that are read as JSON take them:
# "//" to the end of the line, and "/* */"
context // \n brown
    spellcheck

context /\* \*/ brown
    spellcheck

#=============================
# String values
context " " green
    spellcheck
    keyword \\\{"\\/bfnrt\} brightgreen
    keyword \\u\{0123456789ABCDEFabcdef\}\{0123456789ABCDEFabcdef\}\{0123456789ABCDEFabcdef\}\{0123456789ABCDEFabcdef\} brightgreen
