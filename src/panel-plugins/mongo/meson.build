mongo_plugin_dir = panel_plugins_dir / 'mongo'
shared_module('mc-panel-mongo',
  'mongo.c',
  'mongo_bucket.c',
  'mongo_columns.c',
  'mongo_conn.c',
  'mongo_config.c',
  'mongo_connections.c',
  'mongo_docops.c',
  'mongo_filter.c',
  'mongo_nav.c',
  'mongo_render.c',
  'mongo_scram.c',
  'mongo_session.c',
  'mongo_settings.c',
  'mongo_ui.c',
  'mongo_wizard.c',
  'mongo_wizard_json.c',
  'mongo_wizard_parse.c',
  c_args: '-DMC_PLUGIN_DIR="@0@"'.format(mongo_plugin_dir),
  name_prefix: '',
  name_suffix: 'so',
  dependencies: [plugin_deps, mongoc],
  install: true,
  install_dir: mongo_plugin_dir,
)
install_data('mongo_panel.md', install_dir: mongo_plugin_dir)
