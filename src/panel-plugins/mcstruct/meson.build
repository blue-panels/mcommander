mcstruct_plugin_dir = panel_plugins_dir / 'mcstruct'
mcstruct_c_args = '-DMC_PLUGIN_DIR="@0@"'.format(mcstruct_plugin_dir)

# the structure language: parser, evaluator, reader; the tests link it too
libmcslv = static_library('mcslv',
  'slv_expr.c',
  'slv_call.c',
  'slv_parser.c',
  'slv_eval.c',
  'slv_format.c',
  'slv_reader.c',
  'slv_load.c',
  'slv_edit.c',
  c_args: mcstruct_c_args,
  dependencies: [plugin_deps, zlib, cc.find_library('m', required: false)],
  pic: true,
)

shared_module('mc-panel-mcstruct',
  'mcstruct.c',
  'mcstruct_ui.c',
  'mcstruct_grid.c',
  'mcstruct_cmd.c',
  'mcstruct_bytes.c',
  'mcstruct_layout.c',
  c_args: mcstruct_c_args,
  name_prefix: '',
  name_suffix: 'so',
  link_with: libmcslv,
  dependencies: [plugin_deps, zlib],
  install: true,
  install_dir: mcstruct_plugin_dir,
)
install_data('mcstruct_panel.md', install_dir: mcstruct_plugin_dir)

