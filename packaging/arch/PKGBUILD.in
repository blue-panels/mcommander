# Maintainer: Ilia Maslakov <il.smind@gmail.com>

pkgname=(mcommander mcommander-plugins mcommander-lua)
pkgver=@VERSION@
pkgrel=1
pkgdesc='Twin-panel text-mode file manager with loadable panel plugins'
arch=('x86_64' 'aarch64')
url='https://blue-panels.github.io/mcommander/'
license=('GPL-3.0-or-later')
makedepends=('meson' 'pkgconf' 'gettext'
             'glib2' 'slang' 'gpm' 'e2fsprogs' 'libssh2' 'curl' 'samba' 'acl'
             'libarchive' 'file' 'mongo-c-driver' 'lua' 'sqlite' 'libx11'
             'chafa')
options=('!emptydirs')
source=("mcommander-${pkgver}.tar.gz::${url}/releases/download/v${pkgver}/mcommander-${pkgver}.tar.gz")
# Filled in by packaging/prepare.sh from the release archive; SKIP when no
# archive was given to it.
b2sums=('@B2SUMS@')

build() {
  # arch-meson turns every auto feature on; the unit tests need check, which
  # is not a dependency here, so they are left out. Link time optimisation is
  # off: with it gcc 15 leaves the recursion in mctree_node_expand_to_depth
  # unrun, and a tree opens collapsed.
  arch-meson "mcommander-${pkgver}" build \
    -Db_lto=false \
    -Dtests=disabled \
    -Dscreen=slang \
    -Dlua=enabled \
    -Dmagic=enabled \
    -Dpanel_plugin_samba=enabled \
    -Dpanel_plugin_acl=enabled \
    -Dpanel_plugin_ftp=enabled \
    -Dpanel_plugin_arcmc=enabled \
    -Dpanel_plugin_s3=enabled \
    -Dpanel_plugin_mongo=enabled \
    -Dpanel_plugin_sqlite=enabled \
    -Dpanel_plugin_sftp=enabled \
    -Dpanel_plugin_shell_link=enabled \
    -Dshell_ssh2=enabled
  meson compile -C build
}

package_mcommander() {
  pkgdesc='Twin-panel text-mode file manager with loadable panel plugins'
  # libe2p comes in through the ext2fs_attr feature, which arch-meson turns
  # on; libmagic through -Dmagic.
  depends=('glib2' 'slang' 'gpm' 'e2fsprogs' 'file')
  optdepends=('mcommander-plugins: panels for archives and remote systems'
              'mcommander-lua: pictures, markdown and PDF in the viewer'
              'groff: man pages and nroff text in the viewer'
              'man-db: man pages in the viewer'
              'python: three of the extfs helpers'
              'libx11: keyboard modifiers under X'
              'aspell: spell checking in the editor'
              'hunspell: spell checking in the editor'
              'ctags: the tag index the editor reads')
  conflicts=('mc6')
  replaces=('mc6')
  backup=('etc/mcommander/ctags.keymap' 'etc/mcommander/edit.indent.rc'
          'etc/mcommander/extensions.ini' 'etc/mcommander/filehighlight.ini'
          'etc/mcommander/keymap.default.ini' 'etc/mcommander/keymap.emacs.ini'
          'etc/mcommander/keymap.ini' 'etc/mcommander/keymap.vim.ini'
          'etc/mcommander/mcedit.menu' 'etc/mcommander/panels.ftp.ini'
          'etc/mcommander/panels.git.ini' 'etc/mcommander/sfs.ini'
          'etc/mcommander/spell.keymap')

  meson install -C build --destdir "${pkgdir}"
  rm -rf "${pkgdir}/usr/lib/mcommander/panel-plugins"
  rm -rf "${pkgdir}/usr/lib/mcommander/runtime-plugins"
  rm -rf "${pkgdir}/usr/share/mcommander/lua"
  # mcstruct opens a panel plugin, so it goes with the plugins.
  rm "${pkgdir}/usr/bin/mcstruct"

  # keymap.ini is installed as a symlink to keymap.default.ini, and pacman
  # cannot keep a symlink through the backup mechanism: the user's edits would
  # be lost on upgrade. Ship it as a file. (Arch FS#50889)
  rm "${pkgdir}/etc/mcommander/keymap.ini"
  cp "${pkgdir}"/etc/mcommander/keymap{.default,}.ini
  install -Dm644 "mcommander-${pkgver}/COPYING" "${pkgdir}/usr/share/licenses/mcommander/COPYING"
  install -Dm644 "mcommander-${pkgver}/CHANGELOG.md" "${pkgdir}/usr/share/doc/mcommander/CHANGELOG.md"
}

package_mcommander-plugins() {
  pkgdesc='Archive and remote system panels for M-Commander'
  depends=("mcommander=${pkgver}-${pkgrel}" 'glib2' 'libssh2' 'curl' 'samba' 'acl'
           'libarchive' 'file' 'mongo-c-driver' 'sqlite')
  optdepends=('git: the Git panel'
              'docker: the Docker panel'
              'kubectl: the Kubernetes panel'
              'openssh: shell links where libssh2 cannot serve the host')

  meson install -C build --destdir "${pkgdir}"
  rm -rf "${pkgdir}/etc" "${pkgdir}/usr/share"
  # Keep the plugin modules and the mcstruct entry point, nothing else: naming
  # what to drop instead left cons.saver and the shell wrappers in both
  # packages, and pacman refuses to install two packages that own the same file.
  find "${pkgdir}/usr/bin" -mindepth 1 ! -name mcstruct -delete
  find "${pkgdir}/usr/lib/mcommander" -mindepth 1 -maxdepth 1 ! -name panel-plugins \
    -exec rm -rf {} +
  install -Dm644 "mcommander-${pkgver}/COPYING" "${pkgdir}/usr/share/licenses/mcommander-plugins/COPYING"
}

package_mcommander-lua() {
  pkgdesc='Lua runtime and scripts for M-Commander'
  depends=("mcommander=${pkgver}-${pkgrel}" 'glib2' 'lua')
  optdepends=('chafa: pictures in the terminal'
              'poppler: text and pages of a PDF'
              'libsixel: img2sixel as the second sixel encoder'
              'binutils: readelf for the ELF view'
              'imagemagick: the line of details above a picture'
              'perl-image-exiftool: the same line where exif is missing')

  meson install -C build --destdir "${pkgdir}"
  rm -rf "${pkgdir}/etc" "${pkgdir}/usr/bin"
  # Keep the runtime plugin and the Lua scripts, drop everything else the
  # install put here: pacman refuses two packages that own the same file.
  find "${pkgdir}/usr/lib/mcommander" -mindepth 1 -maxdepth 1 ! -name runtime-plugins \
    -exec rm -rf {} +
  find "${pkgdir}/usr/share" -mindepth 1 -maxdepth 1 ! -name mcommander -exec rm -rf {} +
  find "${pkgdir}/usr/share/mcommander" -mindepth 1 -maxdepth 1 ! -name lua -exec rm -rf {} +
  install -Dm644 "mcommander-${pkgver}/COPYING" "${pkgdir}/usr/share/licenses/mcommander-lua/COPYING"
}
