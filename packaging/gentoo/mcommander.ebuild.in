EAPI=8

inherit optfeature

DESCRIPTION="Twin-panel text-mode file manager with loadable panel plugins"
HOMEPAGE="https://blue-panels.github.io/mcommander/"
SRC_URI="https://github.com/blue-panels/mcommander/releases/download/v${PV}/mcommander-${PV}.tar.gz"
S="${WORKDIR}/mcommander-${PV}"

LICENSE="GPL-3+"
SLOT="0"
KEYWORDS="~amd64 ~arm64"
IUSE="+arcmc +ftp +gpm +lua +magic +mongo +s3 +samba +sftp +shell-link +shell-ssh2 +slang +sqlite X"
REQUIRED_USE="shell-ssh2? ( shell-link )"

# chafa is read at configure time as well: without it the lua-chafa script is
# not installed at all, so it belongs in DEPEND and not only in RDEPEND.
COMMON_DEPEND="
	dev-libs/glib:2
	slang? ( sys-libs/slang )
	!slang? ( sys-libs/ncurses:0= )
	gpm? ( sys-libs/gpm )
	lua? ( dev-lang/lua:0= )
	magic? ( sys-apps/file )
	samba? ( net-fs/samba )
	ftp? ( net-misc/curl )
	arcmc? ( app-arch/libarchive )
	s3? ( net-misc/curl )
	mongo? ( dev-libs/mongo-c-driver )
	sftp? ( net-libs/libssh2 )
	shell-ssh2? ( net-libs/libssh2 )
	sqlite? ( dev-db/sqlite )
	X? ( x11-libs/libX11 )
	lua? ( media-gfx/chafa )
"
# The files carry their own name, so the distribution mc is not in the way.
# The predecessor under the old name owned the same paths as mc and is not.
RDEPEND="
	!!app-misc/mc6
	${COMMON_DEPEND}
"
DEPEND="${COMMON_DEPEND}"
BDEPEND="
	sys-devel/gettext
	virtual/pkgconfig
"

src_configure() {
	local myconf=(
		--disable-static
		--with-screen="$(usex slang slang ncurses)"
		--with-panel-plugins-dir="/usr/$(get_libdir)/mcommander/panel-plugins"
		--with-editor-plugins-dir="/usr/$(get_libdir)/mcommander/editor-plugins"
		$(use_with gpm gpm-mouse)
		$(use_enable lua lua-plugin)
		$(use_enable magic mctree-magic)
		$(use_enable samba panel-plugin-samba)
		$(use_enable ftp panel-plugin-ftp)
		$(use_enable arcmc panel-plugin-arcmc)
		$(use_enable s3 panel-plugin-s3)
		$(use_enable mongo panel-plugin-mongo)
		$(use_enable sqlite panel-plugin-sqlite)
		$(use_with X x)
		$(use_enable sftp panel-plugin-sftp)
		$(use_enable shell-link panel-plugin-shell-link)
		$(use_enable shell-ssh2 shell-ssh2)
	)
	econf "${myconf[@]}"
}

DOCS=( CHANGELOG.md README.md )

src_install() {
	emake DESTDIR="${D}" install
	find "${D}" -name '*.la' -delete || die
	einstalldocs
}

pkg_postinst() {
	elog "The program is /usr/bin/mcommander, with mc6 as a short symbolic link."
	elog "app-misc/mc can stay installed: no file is shared with it."

	optfeature "nroff text and man pages in the viewer" sys-apps/groff
	optfeature "man pages read through man itself" sys-apps/man-db
	optfeature "spell checking in the editor" app-text/aspell app-text/hunspell
	optfeature "the tag index the editor reads" dev-util/ctags
	optfeature "the Git panel" dev-vcs/git
	optfeature "the Docker panel" app-containers/docker-cli
	optfeature "the Kubernetes panel" sys-cluster/kubectl
	optfeature "shell links where libssh2 cannot serve the host" net-misc/openssh

	if use lua; then
		optfeature "text and pages of a PDF" app-text/poppler[utils]
		optfeature "img2sixel as the second sixel encoder" media-libs/libsixel
		optfeature "readelf for the ELF view" sys-devel/binutils
		optfeature "the line of details above a picture" media-gfx/imagemagick media-gfx/exif
	fi
}
