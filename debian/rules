#!/usr/bin/make -f

# The version comes from .tarball-version in the release archive, which
# packaging/release-source.sh writes. Taking it from the Debian version instead
# would put a series suffix such as ~ubuntu24.04.1 into the version banner.

# Ubuntu turns link time optimisation on by default; Debian does not.  With it,
# gcc 15 leaves the recursion in mctree_node_expand_to_depth unrun, so a tree
# opens collapsed and the mctree_view test fails.  Nothing here needs LTO.
# Link the plugins with -z now as well: they are opened with dlopen, and a
# resolved symbol table is what keeps the first call out of the resolver.
export DEB_BUILD_MAINT_OPTIONS = optimize=-lto hardening=+bindnow

%:
	dh $@

# dh_auto_configure passes a multiarch --libdir; the package keeps the plain
# /usr/lib/mcommander layout, so libdir and libexecdir are named again here.
override_dh_auto_configure:
	dh_auto_configure -- \
		--libdir=lib \
		--libexecdir=lib \
		-Dscreen=slang \
		-Dpanel_plugins_dir=/usr/lib/mcommander/panel-plugins \
		-Deditor_plugins_dir=/usr/lib/mcommander/editor-plugins \
		-Druntime_plugins_dir=/usr/lib/mcommander/runtime-plugins \
		-Dlua=enabled \
		-Dmagic=enabled \
		-Dpanel_plugin_samba=enabled \
		-Dpanel_plugin_acl=enabled \
		-Dpanel_plugin_ftp=enabled \
		-Dpanel_plugin_arcmc=enabled \
		-Dpanel_plugin_s3=enabled \
		-Dpanel_plugin_mongo=enabled \
		-Dpanel_plugin_sqlite=enabled \
		-Dpanel_plugin_sftp=enabled \
		-Dpanel_plugin_shell_link=enabled \
		-Dshell_ssh2=enabled

override_dh_installchangelogs:
	# Ours, not the ChangeLog inherited from upstream mc, which dh_installchangelogs
	# would find on its own and which stops where this fork begins.
	dh_installchangelogs CHANGELOG.md

override_dh_missing:
	dh_missing --fail-missing
