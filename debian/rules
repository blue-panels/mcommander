#!/usr/bin/make -f

# Neither mc-version.h nor autoreconf is run here: the release archive is
# bootstrapped and carries both that header and the configure script. Writing
# the header from the Debian version would also put a series suffix such as
# ~ubuntu24.04.1 into the version banner.

# Ubuntu turns link time optimisation on by default; Debian does not.  With it,
# gcc 15 leaves the recursion in mctree_node_expand_to_depth unrun, so a tree
# opens collapsed and the mctree_view test fails.  Nothing here needs LTO.
# Link the plugins with -z now as well: they are opened with dlopen, and a
# resolved symbol table is what keeps the first call out of the resolver.
export DEB_BUILD_MAINT_OPTIONS = optimize=-lto hardening=+bindnow

%:
	dh $@

override_dh_auto_configure:
	dh_auto_configure -- \
		--prefix=/usr \
		--sysconfdir=/etc \
		--libexecdir=/usr/lib \
		--disable-static \
		--with-screen=slang \
		--with-panel-plugins-dir=/usr/lib/mcommander/panel-plugins \
		--with-editor-plugins-dir=/usr/lib/mcommander/editor-plugins \
		--with-runtime-plugins-dir=/usr/lib/mcommander/runtime-plugins \
		--enable-lua-plugin=yes \
		--enable-mctree-magic=yes \
		--enable-panel-plugin-samba=yes \
		--enable-panel-plugin-ftp=yes \
		--enable-panel-plugin-arcmc=yes \
		--enable-panel-plugin-s3=yes \
		--enable-panel-plugin-mongo=yes \
		--enable-panel-plugin-sqlite=yes \
		--enable-panel-plugin-sftp=yes \
		--enable-panel-plugin-shell-link=yes \
		--enable-shell-ssh2=yes

override_dh_auto_install:
	dh_auto_install
	find debian/tmp -name '*.la' -delete

override_dh_installchangelogs:
	# Ours, not the ChangeLog inherited from upstream mc, which dh_installchangelogs
	# would find on its own and which stops where this fork begins.
	dh_installchangelogs CHANGELOG.md

override_dh_missing:
	dh_missing --fail-missing
